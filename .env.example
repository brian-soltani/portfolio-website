# Formspree form ID for the contact form.
# Create a free form at https://formspree.io, then copy the ID from the
# endpoint URL (https://formspree.io/f/<THIS_PART>) into .env.local:
#
#   NEXT_PUBLIC_FORMSPREE_ID=yourFormId
#
# Reserved for a future contact form; the current site uses social profile links.
NEXT_PUBLIC_FORMSPREE_ID=
